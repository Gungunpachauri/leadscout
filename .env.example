# Optional: enables AI acquisition briefs. Without it the app runs rules-only
# with deterministic template emails.
ANTHROPIC_API_KEY=
# Optional: override the model used for briefs (default: claude-opus-5-5).
ANTHROPIC_MODEL=

# Optional: hosted libSQL (Turso) for the enrichment cache in production.
# Defaults to a local SQLite file (leadscout.db) when unset.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
