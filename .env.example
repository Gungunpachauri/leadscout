# --- Optional AI briefs (pick one). Without a key the app runs rules-only
# with deterministic template emails. Scoring never uses AI.

# Google Gemini: free tier available, key from https://aistudio.google.com/apikey
# (free-tier prompts may be used by Google to improve its products).
GEMINI_API_KEY=
# Optional model override (default: gemini-3.5-flash-lite, fast and on the free tier).
GEMINI_MODEL=

# Anthropic Claude: paid, key from https://console.anthropic.com
ANTHROPIC_API_KEY=
# Optional model override (default: claude-opus-5-5).
ANTHROPIC_MODEL=

# If both keys are set, Claude is used. Force one with: AI_PROVIDER=gemini
AI_PROVIDER=

# --- Optional: hosted libSQL (Turso) for the enrichment cache in production.
# Defaults to a local SQLite file (leadscout.db) when unset.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
