# Optional: enables AI acquisition briefs + personalised outreach emails.
# Without it the app runs in rules-only mode with template emails.
ANTHROPIC_API_KEY=

# Optional: hosted libSQL (Turso) for the enrichment cache in production.
# Defaults to a local SQLite file (leadscout.db) when unset.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
